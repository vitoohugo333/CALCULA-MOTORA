p=".1" class="input-vetta no-mask"></div></div>
        <div><label class="label-micro">Receita média por km</label><div class="input-wrapper"><span>R$</span><input data-model="revenueKm" type="number" step=".01" class="input-vetta"></div></div>
      </div>

      <div class="card-vetta p-6"><div class="flex justify-between items-center"><div><span class="label-micro !text-vetta-900">Custos personalizados</span><p class="text-xs text-slate-500">Obrigações, reservas, custos por km e taxas.</p></div><button id="addCostButton" class="w-11 h-11 rounded-2xl bg-blue-600 text-white"><i class="fas fa-plus"></i></button></div><div id="costSummary" class="grid grid-cols-2 gap-3 mt-5"></div><div id="costList" class="space-y-3 mt-5"></div></div>

      <div id="learningCard" class="card-vetta p-6 bg-gradient-to-br from-purple-50 to-white"><span class="label-micro !text-purple-700">Aprendizado local</span><h3 class="font-extrabold text-lg">O VETTA aprende com seus registros</h3><p id="learningText" class="text-xs text-slate-500 mt-2">Depois de alguns dias, aparecerão sugestões — sempre com sua confirmação.</p><div id="learningActions" class="space-y-3 mt-4"></div></div>

      <button id="resetButton" class="w-full py-4 rounded-2xl bg-white border border-slate-200 text-sm font-bold text-slate-600">Restaurar valores padrão</button>
    </section>

    <section id="view-more" class="view-section hidden space-y-6 animate-enter">
      <div class="rounded-[2rem] bg-white p-8 shadow-float border border-blue-50 flex justify-between"><div><h2 class="font-extrabold text-2xl">Mais</h2><p class="text-xs text-slate-400 mt-1">Simulações, relatórios e ferramentas extras.</p></div><div class="w-12 h-12 bg-blue-50 rounded-2xl grid place-items-center text-blue-600"><i class="fas fa-grid-2"></i></div></div>

      <details class="card-vetta overflow-hidden" id="compareDetails"><summary class="details-summary"><div><span class="label-micro !mb-0 !text-vetta-900">Simulador</span><strong>Comparar Gasolina × GNV</strong></div><i class="fas fa-chevron-down"></i></summary><div class="p-6 pt-0 space-y-5"><p class="text-xs text-slate-500">A simulação não altera sua meta até você confirmar.</p><div class="grid grid-cols-2 gap-3"><div><label class="label-micro">Gasolina R$/L</label><input id="compareGasPrice" type="number" step=".01" class="input-vetta no-mask"></div><div><label class="label-micro">Gasolina km/L</label><input id="compareGasEff" type="number" step=".1" class="input-vetta no-mask"></div><div><label class="label-micro">GNV R$/m³</label><input id="compareGnvPrice" type="number" step=".01" class="input-vetta no-mask"></div><div><label class="label-micro">GNV km/m³</label><input id="compareGnvEff" type="number" step=".1" class="input-vetta no-mask"></div></div><div class="flex justify-between items-center"><h4 id="chartTitle" class="text-xs font-bold uppercase">Projeção em 1 ano</h4><div class="flex bg-slate-100 p-1 rounded-lg"><button data-period="1" class="period-button px-3 py-1.5 rounded-md text-[10px] font-bold">1</button><button data-period="3" class="period-button px-3 py-1.5 rounded-md text-[10px] font-bold">3</button><button data-period="5" class="period-button px-3 py-1.5 rounded-md text-[10px] font-bold">5 anos</button></div></div><div class="chart-container-bar"><canvas id="compareChart"></canvas></div><div class="grid grid-cols-2 gap-3"><div class="bg-blue-50 rounded-2xl p-4"><span class="label-micro !text-blue-700">Gasolina/km</span><strong id="gasCostKm">R$ 0</strong><button id="applyGasButton" class="block mt-3 text-[10px] font-extrabold text-blue-600">USAR NAS METAS</button></div><div class="bg-amber-50 rounded-2xl p-4"><span class="label-micro !text-amber-700">GNV/km</span><strong id="gnvCostKm">R$ 0</strong><button id="applyGnvButton" class="block mt-3 text-[10px] font-extrabold text-amber-600">USAR NAS METAS</button></div></div><div class="bg-emerald-50 p-5 rounded-2xl"><span class="label-micro !text-emerald-700">Economia projetada</span><strong id="projectedSaving" class="block text-3xl font-black text-emerald-600">R$ 0</strong><p id="savingCaption" class="text-xs text-slate-500 mt-2"></p></div></div></details>

      <div class="card-vetta p-6"><span class="label-micro !text-vetta-900">Relatório do mês</span><p class="text-xs text-slate-500 mb-4">Gere um resumo pronto para imprimir ou salvar em PDF.</p><button id="reportButton" class="w-full py-4 rounded-2xl bg-vetta-900 text-white text-sm font-extrabold"><i class="fas fa-file-lines mr-2"></i>Gerar relatório</button></div>

      <div class="card-vetta p-6"><span class="label-micro !text-vetta-900">Seus dados</span><p class="text-xs text-slate-500 mb-4">Faça backup antes de trocar de celular.</p><div class="grid grid-cols-2 gap-3"><button id="exportButton" class="py-3 rounded-2xl bg-blue-50 text-blue-600 text-xs font-extrabold">Exportar</button><label class="py-3 rounded-2xl bg-slate-100 text-slate-600 text-xs font-extrabold text-center">Importar<input id="importInput" type="file" accept="application/json" class="hidden"></label></div></div>

      <div class="card-vetta p-6"><div class="flex justify-between items-center"><div><span class="label-micro !text-vetta-900">Radar local</span><p class="text-xs text-slate-500">Eventos, alertas e oportunidades salvos só neste aparelho.</p></div><button id="addEventButton" class="w-11 h-11 rounded-2xl bg-emerald-500 text-white"><i class="fas fa-plus"></i></button></div><div id="eventList" class="space-y-3 mt-5"></div><p class="text-[10px] text-slate-400 mt-4">A publicação para outros motoristas exigirá conta e servidor em uma fase futura.</p></div>

      <button id="installCardButton" class="w-full card-vetta p-5 flex justify-between items-center text-left"><div><span class="label-micro !text-blue-600">Aplicativo</span><strong class="block">Instalar ou ver instruções</strong></div><i class="fas fa-mobile-screen-button text-blue-600"></i></button>
    </section>
  </main>

  <nav class="fixed bottom-0 inset-x-0 z-50 px-3 safe-bottom"><div class="max-w-lg mx-auto bg-vetta-900 rounded-[1.6rem] p-2 shadow-2xl flex gap-1"><button data-view="dashboard" class="nav-item active flex-1 rounded-2xl py-3 flex flex-col items-center gap-1"><i class="fas fa-house"></i><span class="text-[8px] font-bold uppercase">Início</span></button><button data-view="day" class="nav-item flex-1 rounded-2xl py-3 flex flex-col items-center gap-1"><i class="fas fa-plus-circle"></i><span class="text-[8px] font-bold uppercase">Dia</span></button><button data-view="history" class="nav-item flex-1 rounded-2xl py-3 flex flex-col items-center gap-1"><i class="fas fa-clock-rotate-left"></i><span class="text-[8px] font-bold uppercase">Histórico</span></button><button data-view="settings" class="nav-item flex-1 rounded-2xl py-3 flex flex-col items-center gap-1"><i class="fas fa-sliders"></i><span class="text-[8px] font-bold uppercase">Ajustes</span></button><button data-view="more" class="nav-item flex-1 rounded-2xl py-3 flex flex-col items-center gap-1"><i class="fas fa-ellipsis"></i><span class="text-[8px] font-bold uppercase">Mais</span></button></div></nav>

  <div id="installModal" class="modal-backdrop hidden"><div class="modal-sheet"><div class="flex justify-between"><h3 class="text-xl font-extrabold">Instalar o VETTA</h3><button id="closeInstallModal" class="w-9 h-9 rounded-full bg-slate-100"><i class="fas f