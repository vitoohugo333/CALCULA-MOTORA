
  <nav class="sticky top-0 z-40 px-5 py-4 bg-white/90 backdrop-blur-xl border-b border-slate-100/60">
    <div class="mx-auto flex justify-between items-center max-w-lg">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-vetta-900 flex items-center justify-center text-white shadow-xl shadow-slate-900/20"><i class="fas fa-layer-group text-lg"></i></div>
        <div><h1 class="text-xl font-extrabold tracking-tight leading-none">VETTA</h1><span class="text-[10px] text-slate-400 font-bold tracking-[.2em] uppercase">Intelligence</span></div>
      </div>
      <button id="installButton" class="px-3 py-2 rounded-full bg-blue-50 text-blue-600 text-[10px] font-extrabold uppercase flex items-center gap-2"><i class="fas fa-arrow-down-to-line"></i><span id="installButtonLabel">Instalar</span></button>
    </div>
  </nav>

  <main class="mx-auto p-5 flex-grow w-full max-w-lg space-y-8">
    <section id="view-dashboard" class="view-section space-y-6 animate-enter">
      <div class="relative overflow-hidden rounded-[2rem] bg-vetta-900 p-8 shadow-2xl shadow-slate-900/30 text-white">
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600 rounded-full mix-blend-overlay blur-[80px] opacity-30 translate-x-1/2 -translate-y-1/2"></div>
        <div class="absolute bottom-0 left-0 w-40 h-40 bg-emerald-500 rounded-full mix-blend-overlay blur-[60px] opacity-20 -translate-x-1/2 translate-y-1/2"></div>
        <div class="relative z-10">
          <div class="flex justify-between items-start mb-7">
            <div><span class="text-[10px] font-bold text-slate-400 tracking-widest uppercase">Meta de faturamento por dia</span><div class="flex items-baseline gap-1 mt-1"><span class="text-2xl font-medium text-slate-400">R$</span><span id="kpiGrossDaily" class="text-6xl font-extrabold tracking-tight tabular">0</span></div></div>
            <div class="bg-white/10 px-3 py-1.5 rounded-full border border-white/10"><span id="navFuelPrice" class="text-[10px] font-bold">R$ 0,00/km</span></div>
          </div>
          <p id="heroStatus" class="text-xs text-slate-300 mb-5 leading-relaxed">Ajustando sua meta.</p>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-white/5 rounded-2xl p-4 border border-white/5"><span class="text-[9px] text-slate-400 uppercase font-bold block mb-1.5">Líquido planejado</span><span id="kpiNetDaily" class="text-xl font-bold text-emerald-400 tabular">R$ 0,00</span></div>
            <div class="bg-white/5 rounded-2xl p-4 border border-white/5 text-right"><span class="text-[9px] text-slate-400 uppercase font-bold block mb-1.5">Rodagem estimada</span><span id="kpiKmDaily" class="text-xl font-bold tabular">0 km</span></div>
          </div>
        </div>
      </div>

      <button data-view="day" class="w-full rounded-[1.45rem] p-5 bg-blue-600 text-white shadow-float flex justify-between items-center">
        <div class="text-left"><span class="block text-[10px] uppercase tracking-widest font-extrabold text-blue-100">Fechamento rápido</span><strong class="block text-lg mt-1">Registrar meu dia</strong></div>
        <span class="w-11 h-11 rounded-2xl bg-white/15 grid place-items-center"><i class="fas fa-arrow-right"></i></span>
      </button>

      <div class="card-vetta p-8">
        <div class="flex justify-between mb-6"><div><label class="label-micro !text-blue-600">Objetivo mensal líquido</label><h3 id="targetProfitDisplay" class="text-3xl font-black tabular">R$ 4.000</h3></div><div class="text-right"><span class="label-micro">Folgas extras</span><strong id="extraDaysOffBadge">0</strong></div></div>
        <input type="range" data-model="targetProfit" min="500" max="20000" step="100" class="w-full mb-7">
        <div class="bg-slate-50 p-1.5 rounded-2xl flex gap-1"><button data-days="5" class="day-button flex-1 py-3 rounded-xl text-[10px] font-bold uppercase">5 dias</button><button data-days="6" class="day-button flex-1 py-3 rounded-xl text-[10px] font-bold uppercase">6 dias</button><button data-days="7" class="day-button flex-1 py-3 rounded-xl text-[10px] font-bold uppercase">7 dias</button></div>
      </div>

      <div class="card-vetta p-6">
        <div class="flex justify-between items-start gap-3"><div><span class="label-micro !text-vetta-900">Situação do mês</span><h3 id="monthStatusTitle" class="text-xl font-extrabold">Comece registrando seu primeiro dia</h3></div><span id="monthStatusPill" class="px-3 py-1.5 rounded-full text-[10px] font-extrabold status-neutral">SEM DADOS</span></div>
        <p id="monthStatusText" class="text-xs text-slate-500 mt-3 leading-relaxed"></p><div class="progress-track mt-5"><div id="monthProgress" class="progress-fill" style="width:0%"></div></div>
        <div class="grid grid-cols-3 gap-3 mt-5 text-center"><div><span class="label-micro">Líquido gerado</span><strong id="actualNet" class="text-sm tabular">R$ 0</strong></div><div><span class="label-micro">Projeção</span><strong id="projectedNet" class="text-sm tabular">R$ 0</strong></div><div><span class="label-micro">Dias restantes</span><strong id="remainingDays" class="text-sm">0</strong></div></div>
      </div>

      <div class="card-vetta p-6">
        <div class="flex justify-between items-start"><div><span class="label-micro !text-vetta-900">Esta semana</span><h3 id="weekStatusTitle" class="text-lg font-extrabold">Planejamento semanal</h3></div><span id="weekStatusPill" class="px-3 py-1.5 rounded-full text-[10px] font-extrabold status-neutral">SEMANA</span></div>
        <p id="weekStatusText" class="text-xs text-slate-500 mt-2"></p>
        <div class="grid grid-cols-3 gap-3 mt-5 text-center"><div><span class="label-micro">Meta líquida</span><strong id="weekTarget" class="text-sm">R$ 0</strong></div><div><span class="label-micro">Realizado</span><strong id="weekActual" class="text-sm text-emerald-600">R$ 0</strong></div><div><span class="label-micro">Média/km</span><strong id="weekRevenueKm" class="text-sm">R$ 0</strong></div></div>
      </div>

      <div class="card-vetta overflow-hidden">
        <div class="p-6 border-b border-slate-50 bg-blue-50/50 flex justify-between"><span class="label-micro !mb-0 !text-vetta-900">Distribuição da meta</span><i class="fas fa-chart-pie text-slate-300"></i></div>
        <div class="p-6"><div class="chart-container mb-6"><canvas id="revenueChart"></canvas></div>
          <div class="flex justify-between py-2 border-b border-dashed border-slate-100"><span class="text-sm font-bold">Faturamento bruto necessário</span><span id="dreGross" class="font-bold text-blue-600 tabular">R$ 0</span></div>
          <div class="flex justify-between py-2 text-xs text-slate-500"><span>Rodagem mensal estimada</span><strong id="dreKm">0 km</strong></div>
          <div class="space-y-1 mb-4"><div class="flex justify-between text-xs text-red-500 bg-red-50/50 p-2 rounded-lg"><span>Combustível</span><strong id="dreFuel">R$ 0</strong></div><div class="flex justify-between text-xs text-orange-500 bg-orange-50/50 p-2 rounded-lg"><span>Custos por km</span><strong id="dreVariable">R$ 0</strong></div><div class="flex justify-between text-xs text-purple-500 bg-purple-50/50 p-2 rounded-lg"><span>Taxas percentuais</span><strong id="drePercent">R$ 0</strong></div><div class="flex justify-between text-xs text-blue-500 bg-blue-50/50 p-2 rounded-lg"><span>Obrigações e reservas</span><s