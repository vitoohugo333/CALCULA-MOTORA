trong id="dreFixed">R$ 0</strong></div></div>
          <div class="flex justify-between items-center bg-emerald-50 p-3 rounded-xl"><span class="text-xs font-bold text-emerald-700 uppercase">Objetivo líquido</span><span id="dreNet" class="text-xl font-black text-emerald-600 tabular">R$ 0</span></div>
        </div>
      </div>

      <div class="card-vetta p-6 bg-gradient-to-br from-blue-50 to-white"><div class="flex gap-4"><div class="w-11 h-11 shrink-0 rounded-2xl bg-blue-600 text-white grid place-items-center"><i class="fas fa-wand-magic-sparkles"></i></div><div><span class="label-micro !text-blue-700">Leitura do VETTA</span><h3 id="insightTitle" class="font-extrabold text-lg">Sua meta está pronta</h3><p id="insightText" class="text-xs text-slate-500 mt-2"></p></div></div><div id="insightReasons" class="mt-4 space-y-2"></div></div>
    </section>

    <section id="view-day" class="view-section hidden space-y-6 animate-enter">
      <div class="rounded-[2rem] bg-vetta-900 p-8 text-white"><span class="text-[10px] text-blue-300 font-extrabold uppercase tracking-widest">Fechamento diário</span><h2 class="text-2xl font-extrabold mt-2">Como foi seu dia?</h2><p class="text-sm text-slate-400 mt-2">Informe só faturamento e quilômetros.</p></div>
      <div class="card-vetta p-6 space-y-5"><div><label class="label-micro">Data</label><input id="recordDate" type="date" class="input-vetta no-mask"></div><div class="grid grid-cols-2 gap-3"><div><label class="label-micro">Faturamento</label><div class="input-wrapper"><span>R$</span><input id="recordGross" type="number" step=".01" class="input-vetta"></div></div><div><label class="label-micro">Quilômetros</label><input id="recordKm" type="number" step=".1" class="input-vetta no-mask"></div></div><div class="grid grid-cols-2 gap-3"><div><label class="label-micro">Horas online (opcional)</label><input id="recordHours" type="number" step=".1" class="input-vetta no-mask"></div><div><label class="label-micro">Combustível gasto (opcional)</label><div class="input-wrapper"><span>R$</span><input id="recordFuel" type="number" step=".01" class="input-vetta"></div></div></div></div>
      <div class="card-vetta p-6"><span class="label-micro !text-vetta-900">Prévia do fechamento</span><div class="grid grid-cols-2 gap-3"><div class="bg-slate-50 rounded-2xl p-4"><span class="label-micro">Custo estimado</span><strong id="previewCost">R$ 0</strong></div><div class="bg-emerald-50 rounded-2xl p-4"><span class="label-micro !text-emerald-700">Líquido do dia</span><strong id="previewNet" class="text-emerald-600">R$ 0</strong></div><div class="bg-blue-50 rounded-2xl p-4"><span class="label-micro !text-blue-700">Receita/km</span><strong id="previewRevenueKm" class="text-blue-600">R$ 0</strong></div><div class="bg-amber-50 rounded-2xl p-4"><span class="label-micro !text-amber-700">Comparação</span><strong id="previewDelta" class="text-amber-600">R$ 0</strong></div></div><p id="previewExplanation" class="text-xs text-slate-500 mt-4"></p></div>
      <button id="saveDayButton" class="w-full py-4 rounded-2xl bg-blue-600 text-white text-sm font-extrabold shadow-float">Fechar e salvar o dia</button><button id="clearDayButton" class="w-full py-3 text-xs font-bold text-slate-400">Limpar formulário</button>
    </section>

    <section id="view-history" class="view-section hidden space-y-6 animate-enter">
      <div class="rounded-[2rem] bg-white p-8 shadow-float border border-blue-50 flex justify-between"><div><h2 class="font-extrabold text-2xl">Histórico</h2><p class="text-xs text-slate-400 mt-1">Resultado real, sem ilusão de faturamento.</p></div><div class="w-12 h-12 bg-blue-50 rounded-2xl grid place-items-center text-blue-600"><i class="fas fa-calendar-check"></i></div></div>
      <div class="grid grid-cols-3 gap-3"><div class="card-vetta p-4 text-center"><span class="label-micro">Dias</span><strong id="historyDays">0</strong></div><div class="card-vetta p-4 text-center"><span class="label-micro">Média/km</span><strong id="historyRevenueKm">R$ 0</strong></div><div class="card-vetta p-4 text-center"><span class="label-micro">Líquido</span><strong id="historyNet" class="text-emerald-600">R$ 0</strong></div></div>
      <div class="card-vetta p-6"><span class="label-micro !text-vetta-900">Evolução do líquido</span><div class="chart-container-line"><canvas id="historyChart"></canvas></div></div>
      <div id="historyInsight" class="card-vetta p-6 bg-gradient-to-br from-emerald-50 to-white"></div>
      <div><div class="flex justify-between mb-3"><h3 class="font-extrabold">Dias registrados</h3><span id="historyCount" class="text-[10px] font-bold text-slate-400">0 REGISTROS</span></div><div id="historyList" class="space-y-3"></div></div>
    </section>

    <section id="view-settings" class="view-section hidden space-y-6 animate-enter">
      <div class="rounded-[2rem] bg-vetta-900 p-8 text-white"><h2 class="text-2xl font-extrabold">Ajustes</h2><p class="text-sm text-slate-400">Sua operação, seus custos e suas regras.</p></div>

      <div class="card-vetta p-6"><span class="label-micro !text-vetta-900">Dias em que pretende trabalhar</span><div class="grid grid-cols-7 gap-1.5 mt-3"><button data-weekday="1" class="weekday-button py-3 rounded-xl text-[10px] font-bold">SEG</button><button data-weekday="2" class="weekday-button py-3 rounded-xl text-[10px] font-bold">TER</button><button data-weekday="3" class="weekday-button py-3 rounded-xl text-[10px] font-bold">QUA</button><button data-weekday="4" class="weekday-button py-3 rounded-xl text-[10px] font-bold">QUI</button><button data-weekday="5" class="weekday-button py-3 rounded-xl text-[10px] font-bold">SEX</button><button data-weekday="6" class="weekday-button py-3 rounded-xl text-[10px] font-bold">SÁB</button><button data-weekday="0" class="weekday-button py-3 rounded-xl text-[10px] font-bold">DOM</button></div><div class="mt-5"><label class="label-micro">Folgas extras neste mês</label><input data-model="extraDaysOff" type="number" min="0" max="20" class="input-vetta no-mask"></div><p id="calendarSummary" class="text-xs text-slate-500 mt-3"></p></div>

      <div class="card-vetta p-6 space-y-5"><div class="flex justify-between items-center"><div><span class="label-micro !text-vetta-900">Combustível das metas</span><p class="text-xs text-slate-500">Este é o combustível que afeta seu lucro.</p></div><span id="fuelCostBadge" class="px-3 py-1.5 rounded-full text-[10px] font-extrabold bg-amber-50 text-amber-600">R$ 0/km</span></div>
        <div><label class="label-micro">Tipo de combustível</label><select id="fuelType" class="input-vetta"><option value="gnv">GNV</option><option value="gasoline">Gasolina</option><option value="ethanol">Etanol</option><option value="diesel">Diesel</option><option value="custom">Personalizado</option></select></div>
        <div id="customFuelNameWrap" class="hidden"><label class="label-micro">Nome do combustível</label><input id="fuelLabel" class="input-vetta no-mask" maxlength="30"></div>
        <div class="grid grid-cols-2 gap-3"><div><label class="label-micro">Preço por <span id="fuelUnitLabel">unidade</span></label><div class="input-wrapper"><span>R$</span><input id="fuelPrice" type="number" step=".01" class="input-vetta"></div></div><div><label class="label-micro">Rendimento km/<span id="fuelEfficiencyUnit">un.</span></label><input id="fuelEfficiency" type="number" ste