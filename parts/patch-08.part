(() => {
  const RELEASE = '3.4.1';

  defaults.version = 8;
  defaults.release = RELEASE;

  const bindCostModal = () => {
    const saveButton = document.getElementById('saveCostButton');
    const closeButton = document.getElementById('closeCostModal');
    const template = document.getElementById('costTemplate');
    const kind = document.getElementById('costKind');

    if (saveButton) {
      saveButton.type = 'button';
      saveButton.onclick = event => {
        event.preventDefault();
        event.stopPropagation();
        if (saveButton.dataset.saving === 'true') return;
        saveButton.dataset.saving = 'true';
        const originalText = saveButton.textContent;
        saveButton.textContent = 'Salvando...';
        saveButton.disabled = true;
        try {
          app.saveCost();
        } catch (error) {
          console.error('Falha ao salvar custo', error);
          app.toast('Não foi possível salvar este custo. Revise os campos e tente novamente.');
        } finally {
          saveButton.dataset.saving = 'false';
          saveButton.textContent = originalText;
          saveButton.disabled = false;
        }
      };
    }

    if (closeButton) {
      closeButton.type = 'button';
      closeButton.onclick = event => {
        event.preventDefault();
        app.closeModal('costModal');
      };
    }

    if (template) template.onchange = event => app.applyCostTemplate(event.target.value);
    if (kind) kind.onchange = () => app.syncCostModal();

    ['costName', 'costCategory', 'costValue', 'costDueDay', 'costMonth'].forEach(id => {
      const field = document.getElementById(id);
      if (field) field.oninput = () => app.updateCostImpactPreview();
    });
  };

  const baseOpenCostModal = app.openCostModal;
  app.openCostModal = function(cost = null) {
    bindCostModal();
    return baseOpenCostModal.call(this, cost);
  };

  const baseRender = app.render;
  app.render = function() {
    baseRender.call(this);
    bindCostModal();
    if (this.$('appVersionLabel')) this.$('appVersionLabel').textContent = `Versão ${RELEASE}`;
  };

  bindCostModal();
})();
